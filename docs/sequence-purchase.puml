@startuml sequence-purchase
title Customer purchase - validate first, then change stock and credit

actor Customer
participant "CustomerView" as view
participant "App.tsx" as app
participant "api.ts" as api
participant "MachineController" as controller
participant "MachineService" as service
participant "VendingMachine" as machine
participant "MachineExceptionHandler" as errors

Customer -> view : clicks + on a product
view -> app : onSetQuantity(product, quantity)
app -> app : cart.ts clamps quantity to stock
note right of app
  The cart is remembered in the browser.
  The server still checks stock and credit
  when the customer pays.
end note

Customer -> view : inserts coins
view -> app : onInsertCoin(amount)
app -> api : insertCredit(amount)
api -> controller : POST /api/machine/credit\n{amount}
controller -> service : insertCoin(amount)
service -> machine : insertCoin(amount)
machine --> service : MachineView
service --> controller
controller --> api : 200 MachineView
api --> app : validated MachineView
app -> view : redraw with new credit

Customer -> view : clicks Pay
view -> app : onPay()
app -> api : purchase(cart lines)
api -> controller : POST /api/machine/purchase\n{items: [{productId, quantity}]}
controller -> service : purchase(CartLine list)
service -> machine : purchase(lines)

group Check every cart line before changing anything
  machine -> machine : merge duplicate product lines
  machine -> machine : reject empty, null, or invalid quantities
  machine -> machine : check each product exists and has enough stock
  alt any line exceeds stock
    machine --x service : MachineException(INSUFFICIENT_STOCK)
    service --x controller
    controller -> errors : handle domain exception
    errors --> api : 409 problem+json {code, detail}
    api --> app : ApiError
    app -> Customer : show error banner\nkeep cart and machine state
  else every line fits
    machine -> machine : total = sum(price x quantity)
    alt credit < total
      machine --x service : MachineException(INSUFFICIENT_CREDIT)
      service --x controller
      controller -> errors : handle domain exception
      errors --> api : 409 problem+json {code, detail}
      api --> app : ApiError
      app -> Customer : show error banner\nkeep cart and credit
    else credit covers total
      group Apply the purchase after all checks pass
        machine -> machine : stock -= quantity\nunitsSold += quantity
        machine -> machine : totalRevenue += total
        machine -> machine : credit becomes 0\nremaining value is change
      end
      machine --> service : PurchaseResult
      service --> controller
      controller --> api : 200 PurchaseResult
      api --> app : validated receipt
      app -> app : clear cart and set paid/change notice
      app -> api : getMachine()
      api -> controller : GET /api/machine
      controller -> service : view()
      service -> machine : view()
      machine --> service : MachineView
      service --> controller
      controller --> api : 200 MachineView
      api --> app : validated MachineView
      app -> Customer : show new stock and change notice
    end
  end
end
@enduml
