@startuml architecture
!pragma layout smetana
title Vending machine - application components and connections

left to right direction
skinparam componentStyle rectangle

actor Customer
actor Staff

package "Browser application (React 19 + TypeScript)" {
  component "App.tsx\nOwns screen state and API actions" as app
  component "CustomerView\nProduct shelf and checkout" as customer
  component "StaffView\nMachine statistics and refills" as staff
  component "CartPanel + ProductCard\nCustomer controls" as customerParts
  component "api.ts\nHTTP requests and timeouts" as api
  component "validation.ts\nChecks server data at runtime" as validation
  component "cart.ts + money.ts\nCart rules and exact cents" as cartRules
}

package "Backend (Java 25 + Spring Boot 4)" {
  component "MachineController\n/api/machine/**" as controller
  component "MachineExceptionHandler\nHTTP problem responses" as handler
  component "MachineService\nApplication service" as service
  component "VendingMachine\nBusiness rules and state" as machine
  component "MachineConfig\nCreates the machine" as config
  component "ProductCatalog\nFixed product list" as catalog
  component "MachineProperties\nCapacity and starting stock" as properties
}

Customer --> app : chooses products,\nadds coins, pays
Staff --> app : opens staff view,\nrefills slots
app --> customer : shows customer tab
app --> staff : shows staff tab
customer --> customerParts : renders controls
customer --> cartRules : quantity and totals
app --> cartRules : stores cart
app --> api : calls machine operations
api --> validation : checks every response
api --> controller : HTTP + JSON\nGET/POST /api/machine/**

controller --> service : delegates requests
service --> machine : calls domain operations
controller ..> handler : exceptions are translated
handler --> api : application/problem+json\nwith stable error code
config --> machine : creates the bean that Spring injects
config --> catalog
config --> properties

note bottom of machine
  The machine is the only owner of
  mutable stock, credit, units sold,
  and revenue. State is in memory;
  there is no database.
end note
@enduml
