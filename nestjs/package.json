{
  "name": "dm-vending-machine-nest",
  "version": "0.1.0",
  "private": true,
  "description": "dm drugstore vending machine backend (NestJS) with InfluxDB 3 telemetry",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:prod": "node dist/main.js",
    "dev": "bash scripts/dev.sh",
    "lint": "oxlint src test e2e scripts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --runInBand",
    "test:int": "jest --runInBand test/",
    "test:watch": "jest --watch",
    "test:coverage": "jest --runInBand --coverage",
    "test:e2e": "playwright test",
    "influx:install": "bash scripts/influx-install.sh",
    "influx:start": "bash scripts/influx-start.sh",
    "influx:stop": "bash scripts/influx-stop.sh",
    "db:reset": "bash scripts/db-reset.sh",
    "diagrams": "bash scripts/diagrams.sh"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.6",
    "@playwright/test": "^1.56.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.7.2",
    "@types/supertest": "^6.0.3",
    "jest": "^30.2.0",
    "oxlint": "^1.24.0",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "typescript": "^5.9.3"
  }
}
